{
  "manifest_version": 3,
  "name": "Bro Relay Debug",
  "version": "0.1.1",
  "description": "Remote browser debugging relay.",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://browser-relay-hub.xiewei63936.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bro Relay Debug",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
